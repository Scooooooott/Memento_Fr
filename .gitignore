# Keep Gradle Wrapper JARs, source data, and bundled/test databases versioned.

# Android / Gradle build state
.gradle/
.kotlin/
**/build/
out/
.externalNativeBuild/
.cxx/
.navigation/
captures/
*.class
*.dex
*.hprof

# IDE and machine-local configuration
.idea/
.fleet/
.vscode/
*.iml
local.properties

# Signing material and local environment files
keystore.properties
signing.properties
key.properties
*.jks
*.keystore
*.p12
*.pfx
*.key
*.pem
.env
.env.*
!.env.example

# Packaged Android artifacts (publish these as GitHub Releases instead)
*.apk
*.apk.idsig
*.aab
*.apks
/releases/

# Python caches and virtual environments
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
env/

# Node/package-manager caches and unpacked third-party references
node_modules/
.npm/
tools/fsrs-reference/package/
tools/fsrs-reference/*.tgz

# Project-local SDKs, emulators, caches and scratch work
/.tools/
/.task-backups/
/tmp/

# FLELex workbook builders are source; their local dependencies stay ignored.
/.flelex_artifact/*
!/.flelex_artifact/build_flelex_workbook.mjs
!/.flelex_artifact/build_flelex_selection_workbook.mjs

# Generated reports and exports. Keep textbook, CEFR, and frequency-book CSV inputs.
/outputs/*
!/outputs/a1-french-vocabulary/
/outputs/a1-french-vocabulary/*
!/outputs/a1-french-vocabulary/*.csv
!/outputs/a2-b1-b2-french-vocabulary/
/outputs/a2-b1-b2-french-vocabulary/*
!/outputs/a2-b1-b2-french-vocabulary/*.csv
!/outputs/flelex-cefr-sorted/
/outputs/flelex-cefr-sorted/*
!/outputs/flelex-cefr-sorted/*.csv
!/outputs/flelex-frequency-selection/
/outputs/flelex-frequency-selection/*
!/outputs/flelex-frequency-selection/*.csv

# Generated device/build evidence; Markdown reports and screenshots stay versioned.
*.log
/docs/qa/**/*.db
/docs/qa/**/*.xml
/docs/qa/**/junit/
/docs/qa/gradle-threads.txt

# SQLite transient files (the checked-in content/test databases remain versioned)
*.db-journal
*.db-shm
*.db-wal

# Atomic content-generation staging files
*.db.building*
*.db.*-building*
*.json.*-building

# Local textbook PDFs are source references, not redistributable project sources.
/*.pdf

# Operating-system and editor noise
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
*.orig
*.bak
*.tmp
