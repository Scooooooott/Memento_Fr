.gradle/
.kotlin/
**/build/
local.properties
__pycache__/
*.py[cod]
.pytest_cache/

# Local editor and operating-system files.
.idea/
.vscode/
.vs/
.agents/
.codex/
.aws/
*.iml
.DS_Store
Thumbs.db
Desktop.ini

# Signing material and local secrets; keep example configuration templates.
.env
.env.*
!.env.example
!.env.sample
*.jks
*.keystore
*.p12
*.pfx
*.pem
*.key
keystore.properties
signing.properties

# User data and temporary SQLite sidecars. Formal DBs are NOT globally ignored.
/user-data/
/backups/
/imports/
/exports/
/data/user-data/
/data/backups/
/data/imports/
/data/exports/
/*.db
/*.sqlite
/*.sqlite3
memento-user*.db
memento-qa*.db
memento_user.db
memento-test-*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
*.copying
*.bak
*.orig
*.rej
*~

# APKs, local downloads/research extracts and other generated outputs.
/releases/
/tmp/
/temp/
/outputs/
/logs/
/coverage/
*.apk
*.apks
*.aab
*.hprof
*.log
/提升GHFind评分建议.pdf

# Host-specific bootstrap/dependency records, not dependency specifications.
/data/manifests/copied-inputs.json
/data/manifests/resolved-build-artifacts.json

# Only the two audited formal sources belong to the current app source set.
# Downloaded research snapshots remain local until a separate content workflow is approved.
/data/source-snapshots/*
!/data/source-snapshots/french_content.db
!/data/source-snapshots/spanish_content.db

# Development instructions, plans, research, audits and QA explanations stay local.
/AGENTS.md
/MULTILINGUAL_REFACTOR_PLAN.md
/CONTRIBUTING.md
/app/src/main/java/com/scott/memento/domain/fsrs/README.md
/docs/**
!/docs/
!/docs/qa/
!/docs/qa/baseline/
!/docs/qa/p4/
# These machine-readable inputs are required by the current content/build gates.
!/docs/qa/baseline/reference-audit.json
!/docs/qa/p4/fr-content-diff.json
!/docs/qa/p4/es-content-diff.json
